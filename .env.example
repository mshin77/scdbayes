# Copy to .env (or .Renviron) and fill in only what is in use; both are git-ignored.
# R reads .Renviron from the start-up folder automatically; for .env, run
# readRenviron(".env") before scdbayes::run_app().

# Default provider: local, gemini, openai, or anthropic
SCDBAYES_LLM_PROVIDER=local
SCDBAYES_LLM_MODEL=gemma3:4b
# Local model through Ollama (no key; text stays on this machine)
SCDBAYES_LLM_BASE_URL=http://localhost:11434/v1

# Shared Gemini key (API: text leaves the machine)
GEMINI_API_KEY=
GEMINI_MODEL=
# OpenAI and Anthropic keys are entered in the app's API key field.

# Optional logging
SCDBAYES_LOG_DIR=
SCDBAYES_LOG_SALT=
